{
  "manifestVersion": 1,
  "id": "tf-snag-tab",
  "publisher": "wes-key",
  "version": "0.6.0",
  "name": "tf-snag drift report",
  "description": "Find Terraform drift, provider deprecations and Azure retirement deadlines in the plan you already produce: a pipeline run tab, work items, Teams and pull request comments.",
  "public": true,
  "categories": ["Azure Pipelines"],
  "tags": [
    "terraform", "drift", "drift-detection", "deprecations", "retirements",
    "azure", "infrastructure", "iac", "compliance", "governance"
  ],
  "targets": [
    { "id": "Microsoft.VisualStudio.Services" }
  ],
  "icons": {
    "default": "images/logo.png"
  },
  "content": {
    "details": { "path": "overview.md" }
  },
  "repository": {
    "type": "git",
    "uri": "https://github.com/wes-key/tf-snag"
  },
  "links": {
    "getstarted": { "uri": "https://github.com/wes-key/tf-snag/blob/main/extension/tasks/README.md" },
    "license": { "uri": "https://github.com/wes-key/tf-snag/blob/main/LICENSE" },
    "support": { "uri": "https://github.com/wes-key/tf-snag/issues" }
  },
  "scopes": ["vso.build"],
  "files": [
    { "path": "tab", "addressable": true },
    { "path": "images", "addressable": true },
    { "path": "node_modules/vss-web-extension-sdk/lib", "addressable": true, "packagePath": "lib" },
    { "path": "tasks/tf-snag-install" },
    { "path": "tasks/tf-snag" },
    { "path": "tasks/common/vso.js", "packagePath": "tasks/tf-snag-install/vso.js" },
    { "path": "tasks/common/vso.js", "packagePath": "tasks/tf-snag/vso.js" }
  ],
  "contributions": [
    {
      "id": "tf-snag-build-results-tab",
      "type": "ms.vss-build-web.build-results-tab",
      "targets": ["ms.vss-build-web.build-results-view"],
      "properties": {
        "name": "tf-snag",
        "uri": "tab/drift.html"
      }
    },
    {
      "id": "tf-snag-install-task",
      "type": "ms.vss-distributed-task.task",
      "targets": ["ms.vss-distributed-task.tasks"],
      "properties": {
        "name": "tasks/tf-snag-install"
      }
    },
    {
      "id": "tf-snag-task",
      "type": "ms.vss-distributed-task.task",
      "targets": ["ms.vss-distributed-task.tasks"],
      "properties": {
        "name": "tasks/tf-snag"
      }
    }
  ]
}
