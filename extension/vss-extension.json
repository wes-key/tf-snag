{
  "manifestVersion": 1,
  "id": "tf-snag-tab",
  "publisher": "wes-key",
  "version": "0.6.0",
  "name": "tf-snag drift report",
  "description": "Pipeline tasks that install and run the tf-snag CLI, plus a \"tf-snag\" run tab showing its drift and deprecation findings with ignore-rule and baseline (first-seen) awareness.",
  "public": false,
  "categories": ["Azure Pipelines"],
  "tags": ["terraform", "drift", "infrastructure", "iac"],
  "targets": [
    { "id": "Microsoft.VisualStudio.Services" }
  ],
  "icons": {
    "default": "images/logo.png"
  },
  "content": {
    "details": { "path": "README.md" }
  },
  "scopes": ["vso.build"],
  "files": [
    { "path": "tab", "addressable": true },
    { "path": "images", "addressable": true },
    { "path": "node_modules/vss-web-extension-sdk/lib", "addressable": true, "packagePath": "lib" },
    { "path": "tasks/tf-snag-install" },
    { "path": "tasks/tf-snag" },
    { "path": "tasks/common/vso.js", "packagePath": "tasks/tf-snag-install/vso.js" },
    { "path": "tasks/common/vso.js", "packagePath": "tasks/tf-snag/vso.js" }
  ],
  "contributions": [
    {
      "id": "tf-snag-build-results-tab",
      "type": "ms.vss-build-web.build-results-tab",
      "targets": ["ms.vss-build-web.build-results-view"],
      "properties": {
        "name": "tf-snag",
        "uri": "tab/drift.html"
      }
    },
    {
      "id": "tf-snag-install-task",
      "type": "ms.vss-distributed-task.task",
      "targets": ["ms.vss-distributed-task.tasks"],
      "properties": {
        "name": "tasks/tf-snag-install"
      }
    },
    {
      "id": "tf-snag-task",
      "type": "ms.vss-distributed-task.task",
      "targets": ["ms.vss-distributed-task.tasks"],
      "properties": {
        "name": "tasks/tf-snag"
      }
    }
  ]
}
